CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# luci-lib-docker is not shipped by the official luci, kenzo or small feeds,
# and official luci-app-dockerman does not depend on it.
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
# luci-theme-alpha / luci-theme-material3 are not present in the official luci,
# kenzo or small feeds at the pinned revisions; drop them so defconfig does not
# silently discard the unknown symbols.
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-theme-argone is not set
# CONFIG_PACKAGE_luci-theme-atmaterial_new is not set
# CONFIG_PACKAGE_luci-theme-design is not set
CONFIG_PACKAGE_luci-theme-glass=y
# CONFIG_PACKAGE_luci-theme-ifit is not set
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-theme-openwrt=y
CONFIG_PACKAGE_luci-theme-openwrt-2020=y
# CONFIG_PACKAGE_luci-theme-tomato is not set
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_naiveproxy=y
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_nfs-kernel-server-utils=y
CONFIG_PACKAGE_nfs-utils=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_nlbwmon=y
# Official 25.12 already defaults to firewall4 (fw4) + nftables. Keep
# iptables/ip6tables on the nft compat backend (xtables-nft-multi) so docker/
# miniupnpd/passwall still write via nft_compat instead of legacy ip_tables.
# firewall4 CONFLICTS firewall + kmod-ipt-nat, so both must be off. dnsmasq nftset
# stays OFF so passwall keeps using its proven iptables path (via nft compat).
CONFIG_PACKAGE_firewall4=y
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_kmod-ipt-nat is not set
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_kmod-nft-compat=y
# miniupnpd: use the nftables variant so it does not pull legacy iptables.
# CONFIG_PACKAGE_miniupnpd-iptables is not set
CONFIG_PACKAGE_miniupnpd-nftables=y
