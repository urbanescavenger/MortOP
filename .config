# --- LuCI core + base services -------------------------------------------
# Our .config only listed luci-app-* packages, so no luci-mod-* ever got
# selected (official x86/64 default profile pulls the `luci` metapackage; we
# replaced the profile with our own selection). Result on the first 25.12
# image: /admin/system/system, /admin/network/network, /admin/status/overview
# all 404, no firewall or package-manager UI. luci-mod-admin-full brings
# mod-network/status/system/rpc.
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
# luci-ssl pulls px5g-mbedtls; without it uhttpd has listen_https=443 in its
# config but no cert, so https simply refuses connections.
CONFIG_PACKAGE_luci-ssl=y
# uhttpd-mod-ubus must be selected explicitly: without it /ubus returns 404
# and every LuCI page renders with empty dynamic data (LuCI JS calls /ubus).
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# --- Tools / utilities ---------------------------------------------------
# resize2fs is its own package (+e2fsprogs); the ext4 rootfs cannot be grown
# without it, and e2fsprogs alone does not provide it.
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_ncdu=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_rsync=y
