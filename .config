CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-zerotier=y
# Select the LuCI language instead of individual luci-i18n-* packages: those
# are HIDDEN in luci.mk (DEFAULT:=LUCI_LANG_<lang>||...), so make defconfig
# recomputes them to n and silently drops explicit =y lines. With the language
# selected, every installed app's zh-cn translation defaults to y.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
