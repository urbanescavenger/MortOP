# watchcat stays, but files/etc/config/watchcat raises forcedelay to 180s:
# its default 30s sysrq 'b' hard-resets before the ~49s clean shutdown
# finishes, zeroing directory blocks and leaving the rootfs read-only.
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_watchcat=y
# The kenzo feed directory is luci-app-wechatpush, but its Makefile sets
