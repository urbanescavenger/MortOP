# Enable Magic SysRq so the reboot-fix shutdown safety net can force a kernel
# reboot via /proc/sysrq-trigger when procd/teardown hangs (else reboot freezes
# and the box must be power-cycled).
CONFIG_KERNEL_MAGIC_SYSRQ=y
# Software watchdog kmod: reboot-fix arms /dev/watchdog0 at shutdown start
# (no ping, no magic-close) so the kernel force-resets at SOFTDOG_MARGIN
# seconds even if userspace is killed — a kernel-level backstop for the
# post-stop kernel-reboot hang that the userspace sysrq timer can't reach.
# No-op on builds without it (modprobe fails, /dev/watchdog0 absent).
CONFIG_PACKAGE_kmod-softdog=y
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
CONFIG_NFS_KERNEL_SERVER_V4=y
CONFIG_PACKAGE_6in4=y
# Removed: TAR_* / WECHATPUSH_* / SAMBA_MAX_DEBUG_LEVEL are option symbols,
# not packages; the CONFIG_PACKAGE_ prefix made them dead entries that
# defconfig silently discarded.
CONFIG_PACKAGE_adguardhome=y
# 158 host services that need manual configuration after flashing (containers
# are out of scope). Packages only: adblock lists, frp server/token, nginx
# server blocks and sqm qdiscs are configured on the router, not baked here.
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
